def postGitHubStatus(state, description, targetRepo, targetSha) {
  withCredentials([string(credentialsId: 'github-status-token', variable: 'GITHUB_STATUS_TOKEN')]) {
    echo "Posting qa/regression status '${state}' to ${targetRepo} at ${targetSha}"
    sh """
      status_code=\$(curl -sS -o /tmp/github-status-response.json -w "%{http_code}" -X POST \
        -H 'Accept: application/vnd.github+json' \
        -H 'Authorization: Bearer ${GITHUB_STATUS_TOKEN}' \
        -H 'X-GitHub-Api-Version: 2022-11-28' \
        https://api.github.com/repos/${targetRepo}/statuses/${targetSha} \
        -d '{
          "state":"${state}",
          "context":"qa/regression",
          "description":"${description}",
          "target_url":"${env.BUILD_URL}"
        }')
      echo "GitHub status API HTTP code: \${status_code}"
      cat /tmp/github-status-response.json
      test "\${status_code}" = "201"
    """
  }
}

pipeline {
  agent any

  options {
    timestamps()
    disableConcurrentBuilds()
    timeout(time: 45, unit: 'MINUTES')
  }

  parameters {
    string(name: 'DEV_REPO', defaultValue: 'ksiddu/sample_dev_app', description: 'Dev app repo owner/name')
    string(name: 'DEV_REF', defaultValue: 'master', description: 'Dev app branch or commit SHA')
    string(name: 'APP_URL', defaultValue: '', description: 'Optional deployed app URL')
    string(name: 'MARKER_EXPRESSION', defaultValue: 'regression and not smoke', description: 'Pytest marker expression')
    string(name: 'EXPECTED_TITLE', defaultValue: 'Sample Dev App', description: 'Expected page title')
    string(name: 'EXPECTED_HEADING', defaultValue: 'Sample Dev App', description: 'Expected page heading')
    booleanParam(name: 'POST_STATUS', defaultValue: true, description: 'Post qa/regression back to the dev commit')
  }

  environment {
    VENV_DIR = '.venv'
    DEV_APP_DIR = 'dev_app'
    TARGET_SHA = ''
  }

  stages {
    stage('Checkout QA Repo') {
      steps {
        checkout scm
      }
    }

    stage('Setup Python') {
      steps {
        sh "python3 -m venv ${VENV_DIR}"
        sh ". ${VENV_DIR}/bin/activate && pip install --upgrade pip && pip install -r requirements.txt"
        sh ". ${VENV_DIR}/bin/activate && python -m playwright install --with-deps"
      }
    }

    stage('Prepare Target') {
      steps {
        script {
          def targetSha = ''
          if (params.APP_URL?.trim()) {
            def resolvedSha = sh(
              script: "git ls-remote https://github.com/${params.DEV_REPO}.git ${params.DEV_REF} | awk 'NR==1 {print \$1}'",
              returnStdout: true
            ).trim()
            targetSha = resolvedSha ?: params.DEV_REF?.trim()
          } else {
            sh "rm -rf ${DEV_APP_DIR}"
            sh "git clone --branch ${params.DEV_REF} --depth 1 https://github.com/${params.DEV_REPO}.git ${DEV_APP_DIR}"
            targetSha = sh(script: "git -C ${DEV_APP_DIR} rev-parse HEAD", returnStdout: true).trim()
          }
          env.TARGET_SHA = targetSha ?: ''
          writeFile file: '.target_sha', text: env.TARGET_SHA
          echo "POST_STATUS: ${params.POST_STATUS}"
          echo "DEV_REF: ${params.DEV_REF}"
          echo "APP_URL: ${params.APP_URL}"
          echo "Resolved dev repo target: ${params.DEV_REPO}"
          echo "TARGET_SHA: ${env.TARGET_SHA}"
          if (params.POST_STATUS && !env.TARGET_SHA?.trim()) {
            error('POST_STATUS is true but TARGET_SHA could not be resolved. Provide a valid DEV_REF or disable POST_STATUS.')
          }
        }
      }
    }

    stage('Mark Pending') {
      when {
        expression { return params.POST_STATUS && fileExists('.target_sha') && readFile('.target_sha').trim() }
      }
      steps {
        script {
          postGitHubStatus('pending', 'QA regression is running', params.DEV_REPO, readFile('.target_sha').trim())
        }
      }
    }

    stage('Start Dev App') {
      when {
        expression { return !params.APP_URL?.trim() }
      }
      steps {
        sh "nohup python3 -m http.server 8000 --directory ${DEV_APP_DIR}/app > /tmp/sample-dev-app.log 2>&1 &"
        sh "sleep 2"
      }
    }

    stage('Run Regression') {
      environment {
        EFFECTIVE_APP_URL = "${params.APP_URL?.trim() ? params.APP_URL.trim() : 'http://127.0.0.1:8000'}"
      }
      steps {
        sh """
          . ${VENV_DIR}/bin/activate && \
          APP_URL='${EFFECTIVE_APP_URL}' \
          APP_TITLE='${params.EXPECTED_TITLE}' \
          APP_HEADING='${params.EXPECTED_HEADING}' \
          pytest -m "${params.MARKER_EXPRESSION}" --html=artifacts/report.html --self-contained-html --alluredir=artifacts/allure
        """
      }
    }
  }

  post {
    success {
      script {
        if (params.POST_STATUS && fileExists('.target_sha') && readFile('.target_sha').trim()) {
          postGitHubStatus('success', 'QA regression passed', params.DEV_REPO, readFile('.target_sha').trim())
        }
      }
    }
    failure {
      script {
        if (params.POST_STATUS && fileExists('.target_sha') && readFile('.target_sha').trim()) {
          postGitHubStatus('failure', 'QA regression failed', params.DEV_REPO, readFile('.target_sha').trim())
        }
      }
    }
    always {
      archiveArtifacts artifacts: 'artifacts/**', allowEmptyArchive: true
      sh "pkill -f 'http.server 8000 --directory ${DEV_APP_DIR}/app' || true"
      cleanWs(deleteDirs: true, notFailBuild: true)
    }
  }
}
